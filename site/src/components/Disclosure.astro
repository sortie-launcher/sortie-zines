---
interface Props {
  compact?: boolean;
}
const { compact } = Astro.props;
---
{compact ? (
  <aside class="disclosure disclosure--compact" aria-label="AI disclosure">
    <p>
      <strong>Written with AI</strong> from the sources this article cites, under human direction. The writers have not
      played the games, and facts or quotations can be wrong: check the <a href="#sources">Sources</a> before relying on them.
    </p>
  </aside>
) : (
  <aside class="disclosure" aria-labelledby="disclosure-h">
    <h2 id="disclosure-h">Field Notes is written with AI</h2>
    <p>
      Articles are researched and drafted by AI models from the sources each issue cites, under human direction. The
      writers have not played the games, and facts or quotations can be wrong: check an article's Sources before
      relying on it.
    </p>
  </aside>
)}
